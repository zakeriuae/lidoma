{
  "name": "lidoma",
  "version": "1.0.0",
  "description": "پلتفرم جامع لید مارکتینگ کلینیک‌ها",
  "scripts": {
    "tailwind:build": "npx tailwindcss -i css/input.css -o css/tailwind.css --minify",
    "tailwind:watch": "npx tailwindcss -i css/input.css -o css/tailwind.css --watch",
    "dev": "npm run tailwind:build && npx http-server . -p 5000 -o",
    "start": "npm run tailwind:build && npx http-server . -p 5000 -o",
    "build": "npm run tailwind:build && node build.js"
  },
  "keywords": [
    "lidoma",
    "lead-marketing",
    "clinic"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
